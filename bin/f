#!/usr/bin/env bash

shellenv=/tmp/shellenv.fish
bindir=$(dirname $0)
export SCRIPTS_DIR="$(cd "$bindir";cd ..;pwd)"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$PATH:/nix/var/nix/profiles/default/bin"

cat > "$shellenv" <<EOF
# fish_add_path --path /Applications/Docker.app/Contents/Resources/bin/ > /dev/null

# [n]eovim
function n
  $bindir/n \$argv
end

# [v]vim
function v
  n \$argv
end

# TODO: generate bindings to bin
function php-serve
  $bindir/php-serve \$argv
end

function apply-database
  $bindir/apply-database \$argv
end

function build-zabbix
  $bindir/build-zabbix \$argv
end

function configure-zabbix
  $bindir/configure-zabbix \$argv
end

function create-database
  $bindir/create-database \$argv
end

function scripts:brew
  $bindir/scripts:brew \$argv
end

function :comment
  $bindir/:comment \$argv
end

function scripts:conf
    cp $SCRIPTS_DIR/rice/aerospace/.aerospace.toml $HOME
    aerospace reload-config
end

# needed os config for Zabbix server to run on OSX
# sudo sysctl -w kern.sysv.shmmax=268435456
# sudo sysctl -w kern.sysv.shmall=65536
# sudo sysctl -w kern.sysv.shmseg=32
EOF

fish -C "source $bindir/../fish/config-v42.fish && source '$shellenv'" $@
